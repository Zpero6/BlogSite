DB_URL=jdbc:mysql://localhost:3306/zpero_blog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USER=zpero
DB_PASSWORD=replace-with-local-password
CONTENT_DIR=../content/posts
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
VERIFICATION_PEPPER=replace-with-a-long-random-value

# Creates (or promotes) the first administrator at startup. Leave empty to skip.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-admin-password
ADMIN_DISPLAY_NAME=Zpero

# Integration tests use a separate database and wipe it with Flyway clean.
RUN_MYSQL_IT=false
TEST_DB_URL=jdbc:mysql://localhost:3306/zpero_blog_test?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
TEST_DB_USER=zpero
TEST_DB_PASSWORD=replace-with-local-password
