---
import BaseLayout from '../layouts/BaseLayout.astro';
import JournalHero from '../components/JournalHero.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
const routes = [
  { title: '从并发基础开始', description: '可见性、原子性，以及为什么需要锁。', id: 'volatile-why-lock' },
  { title: '走进锁的实现', description: '从 CAS 到 AQS，串起同步机制的来龙去脉。', id: 'cas-to-aqs' },
  { title: '理解异步任务', description: '线程池与 CompletableFuture，理清任务如何协作。', id: 'future-to-completablefuture' },
].filter(route => posts.some(post => post.id === route.id));
---
<BaseLayout journal title="Zpero · 把问题想透，把过程写下" description="从 Java 并发原理到系统实践，记录问题、推导与实现。Zpero 的技术手记与个人项目。">
  <main class="discovery-page journal-home">
    <JournalHero />
    <div class="home-context"><p>你好，我是 Zpero。这里是我的技术手记与项目工作台。</p><a href="/about/">认识一下</a></div>
    <section class="reading-path" aria-labelledby="reading-path-title">
      <div class="reading-path__intro"><h2 id="reading-path-title">从一个问题开始</h2><p>第一次来？沿着这几条线索读下去。</p></div>
      <div class="reading-path__links">{routes.map(route => <a href={`/blog/${route.id}/`}><strong>{route.title}</strong><p>{route.description}</p><span>开始阅读 ↗</span></a>)}</div>
    </section>
    <section class="journal-latest" id="latest" aria-labelledby="posts-heading">
      <div class="journal-section-heading"><h2 id="posts-heading">最近写下</h2><a class="journal-button" href="/blog/">全部 {posts.length} 篇文章 →</a></div>
      <p class="home-section-description">记录一个问题，也记录想明白它的过程。</p>
      <div class="journal-home-posts">{posts.slice(0,6).map(post => <PostCard post={post} preview />)}</div>
    </section>
    <section aria-labelledby="projects-heading">
      <div class="journal-section-heading"><h2 id="projects-heading">把想法做出来</h2><a class="journal-button" href="/projects/">项目 →</a></div>
      <p class="home-section-description">在实际构建中验证想法，留下可以继续改进的作品。</p>
      <div class="journal-home-posts">{projects.map(project => <ProjectCard project={project} preview />)}</div>
    </section>
  </main>
</BaseLayout>


