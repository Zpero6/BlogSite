---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
---

<BaseLayout title="项目 · Zpero" description="Zpero 的项目实践与设计记录。">
  <main class="subpage mx-auto min-h-[76vh] max-w-[960px] pb-16 pt-[126px] sm:pt-[140px]">
    <header class="mb-9 border-b border-[#171717]/10 pb-8 sm:mb-11 sm:pb-9">
      <div class="mb-4 flex items-center justify-between text-[11px] font-semibold tracking-[.14em] text-[#171717]/45"><span>SELECTED WORKS / 项目</span><span>{String(projects.length).padStart(2, '0')} / PROJECTS</span></div>
      <h1 class="text-[34px] font-bold tracking-[-.065em] text-[#171717] sm:text-[40px]">项目作品<span class="ml-2 text-[#CBF033]">.</span></h1>
      <p class="mt-3 max-w-[660px] text-[13px] leading-[1.9] text-[#171717]/60 sm:text-[14px]">把技术实践、遇到的问题和设计思考认真整理成可阅读的作品。</p>
    </header>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6">
      {projects.map((project, index) => (
        <article class="project-card group flex flex-col overflow-hidden rounded-[11px] border border-zinc-200/70 bg-white transition-all duration-300 hover:-translate-y-[3px] hover:border-zinc-300">
          <div class="relative h-[120px] overflow-hidden border-b border-[#171717]/[.045] bg-[linear-gradient(135deg,#eef1f4,#d1dce2)] sm:h-[140px]" aria-hidden="true"><span class="absolute bottom-[11%] left-[13%] text-[38px] font-extrabold tracking-[-.09em] text-slate-600/55">{['AI', 'TR', 'ZJ', 'GL'][index]}</span><span class="absolute -right-7 -top-16 h-40 w-40 rounded-full border border-slate-500/20 shadow-[0_0_0_28px_rgba(255,255,255,.15),0_0_0_57px_rgba(67,84,98,.045)]"></span></div>
          <div class="flex flex-1 flex-col p-5 sm:p-6">
            <div class="mb-3 flex items-center justify-between text-[10px] tracking-[.08em] text-[#171717]/45"><span>PROJECT {String(index + 1).padStart(2, '0')}</span><span>{project.status}</span></div>
            <h2 class="text-[18px] font-bold leading-[1.45] tracking-[-.045em] sm:text-[20px]">{project.title}</h2>
            <p class="mt-2.5 min-h-[48px] text-[13px] leading-[1.85] text-[#171717]/65 sm:text-[14px]">{project.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">{project.tech.map((tech) => <span class="rounded bg-zinc-100 px-2.5 py-1.5 text-[11px] text-zinc-600">{tech}</span>)}</div>
            <span class="mt-6 flex items-center justify-between border-t border-[#171717]/10 pt-4 text-[12px] font-semibold text-[#171717]/65">项目记录 <Icon name="arrow" size={15} /></span>
          </div>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
