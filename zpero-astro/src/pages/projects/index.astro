---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---
<BaseLayout title="项目 · Zpero" description="Zpero 的项目实践与构建记录。">
  <main class="discovery-page journal-projects">
    <header class="journal-page-heading"><div><p class="journal-page-kicker">Projects</p><h1>项目</h1><p>把想法写成代码，把实践留成记录。</p></div><a class="journal-button" href="https://github.com/Zpero6" target="_blank" rel="noopener noreferrer">GitHub ↗</a></header>
    <section class="journal-project-grid" aria-label="项目列表">{projects.map((project) => <ProjectCard project={project} />)}</section>
    <p class="journal-projects__note">新的项目，会在这里慢慢积累。</p>
  </main>
</BaseLayout>
