---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在 · Zpero" description="没有找到这个页面。">
  <main class="mx-auto flex min-h-[76vh] max-w-[680px] flex-col items-center justify-center pb-16 pt-[126px] text-center">
    <span class="text-[11px] font-semibold tracking-[.16em] text-[#171717]/40">404 / NOT FOUND</span>
    <h1 class="mt-5 text-[36px] font-bold tracking-[-.06em]">页面不存在<span class="text-[#CBF033]">.</span></h1>
    <p class="mt-3 text-[13px] leading-7 text-[#171717]/55">可能是链接已经改变，或者文章尚未发布。</p>
    <a href="/" class="mt-7 rounded-lg bg-[#171717] px-5 py-3 text-[12px] font-semibold text-white">返回首页</a>
  </main>
</BaseLayout>
