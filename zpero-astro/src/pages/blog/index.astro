---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import '../../styles/discovery.css';
const posts = await getPublishedPosts();
const categories = ['后端笔记', '人工智能', '项目沉淀', '生活随感'];
---
<BaseLayout title="文章 · Zpero" description="Zpero 的技术笔记、项目实践和日常记录。">
  <main class="archive-page discovery-page">
    <header class="archive-heading"><div><h1>文章</h1><p>把零散的知识，整理成可以回看的笔记。</p></div><span class="archive-total">共 {posts.length} 篇记录</span></header>
    <nav class="category-filters" aria-label="文章分类">
      {['全部', ...categories].map((category, index) => <button type="button" data-category={index === 0 ? '' : category} aria-pressed={index === 0 ? 'true' : 'false'}><span>{category}</span><span class="filter-count">{index === 0 ? posts.length : posts.filter((post) => post.data.category === category).length}</span></button>)}
    </nav>
    <div class="archive-results" aria-live="polite" aria-atomic="true"><span id="filter-summary">全部文章</span><span id="filter-count">{posts.length} 篇</span></div>
    <div class="archive-grid">
      {posts.map((post) => <div class="archive-item" data-post-category={post.data.category}><PostCard post={post} /></div>)}
    </div>
    <div class="archive-empty" hidden><h2>这里还没有文章</h2><p>这个主题的笔记正在慢慢积累，先看看其他文章吧。</p><button type="button" id="reset-category">查看全部文章</button></div>
    <noscript><p class="archive-noscript">启用 JavaScript 后可按分类筛选；下方已展示全部文章。</p></noscript>
  </main>
</BaseLayout>
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-post-category]')];
  const applyCategory = (category: string, updateUrl = false) => {
    const validCategory = buttons.some((button) => button.dataset.category === category) ? category : '';
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.category === validCategory)));
    let count = 0;
    items.forEach((item) => { item.hidden = !!validCategory && item.dataset.postCategory !== validCategory; if (!item.hidden) count++; });
    const empty = document.querySelector<HTMLElement>('.archive-empty');
    if (empty) empty.hidden = count > 0;
    const summary = document.getElementById('filter-summary');
    const counter = document.getElementById('filter-count');
    if (summary) summary.textContent = validCategory || '全部文章';
    if (counter) counter.textContent = `${count} 篇`;
    if (updateUrl) {
      const url = new URL(location.href);
      if (validCategory) url.searchParams.set('category', validCategory); else url.searchParams.delete('category');
      history.pushState({}, '', url);
    }
  };
  buttons.forEach((button) => button.addEventListener('click', () => applyCategory(button.dataset.category ?? '', true)));
  document.getElementById('reset-category')?.addEventListener('click', () => applyCategory('', true));
  addEventListener('popstate', () => applyCategory(new URL(location.href).searchParams.get('category') ?? ''));
  applyCategory(new URL(location.href).searchParams.get('category') ?? '');
</script>

