---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import '../../styles/discovery.css';
const posts = await getPublishedPosts();
const categories = ['后端笔记', '人工智能', '项目沉淀', '生活随感'];
---
<BaseLayout journal title="文章 · Zpero" description="Zpero 的技术笔记、项目实践和日常记录。">
  <main class="archive-page discovery-page">
    <header class="archive-heading"><div><p>每次理解，都值得留下一页。</p><h1>文章手记</h1></div><p>关于后端原理、工程实践与学习过程。<br/>选一个主题，或者搜索一个你正在思考的问题。</p></header>
    <div class="archive-toolbar"><a class="journal-button" href="/">← 返回首页</a><nav class="category-filters" aria-label="文章分类">{['全部', ...categories].map((category, index) => <button type="button" data-category={index === 0 ? '' : category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}</nav><span class="archive-total">{posts.length} 篇文章</span></div>
    <div class="archive-results" aria-live="polite" aria-atomic="true"><span id="filter-summary">全部文章</span><button type="button" id="clear-tag" hidden>清除标签筛选 ×</button><span id="filter-count">{posts.length} 篇</span></div>
    <div class="archive-grid">{posts.map((post) => <div class="archive-item" data-post-category={post.data.category} data-post-tags={JSON.stringify(post.data.tags)}><PostCard post={post} /></div>)}</div>
    <div class="archive-empty" hidden><h2>这里还没有文章</h2><p>这个主题的笔记正在慢慢积累，先看看其他文章吧。</p><button class="journal-button" type="button" id="reset-category">查看全部文章</button></div>
    <nav class="archive-pagination" aria-label="文章分页" hidden><button class="journal-button" type="button" id="page-prev">← 上一页</button><span id="page-status"></span><button class="journal-button" type="button" id="page-next">下一页 →</button></nav>
    <noscript><p class="archive-noscript">启用 JavaScript 后可按分类筛选；下方已展示全部文章。</p></noscript>
  </main>
</BaseLayout>
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-post-category]')];
  const pageSize = 12;
  let currentPage = 1;
  let category = '';
  let tag = '';
  const render = (writeUrl = false) => {
    if (!buttons.some((button) => button.dataset.category === category)) category = '';
    const matching = items.filter((item) => (!category || item.dataset.postCategory === category) && (!tag || (JSON.parse(item.dataset.postTags ?? '[]') as string[]).includes(tag)));
    const pages = Math.max(1, Math.ceil(matching.length / pageSize));
    currentPage = Math.min(pages, Math.max(1, currentPage));
    items.forEach((item) => { item.hidden = true; });
    matching.slice((currentPage - 1) * pageSize, currentPage * pageSize).forEach((item) => { item.hidden = false; });
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.category === category)));
    document.querySelector<HTMLElement>('.archive-empty')!.hidden = matching.length > 0;
    document.getElementById('filter-summary')!.textContent = [category || '全部文章', tag].filter(Boolean).join(' / ');
    document.getElementById('filter-count')!.textContent = `${matching.length} 篇`;
    document.getElementById('clear-tag')!.hidden = !tag;
    document.querySelector<HTMLElement>('.archive-pagination')!.hidden = pages <= 1;
    document.getElementById('page-status')!.textContent = `${currentPage} / ${pages}`;
    (document.getElementById('page-prev') as HTMLButtonElement).disabled = currentPage === 1;
    (document.getElementById('page-next') as HTMLButtonElement).disabled = currentPage === pages;
    if (writeUrl) {
      const url = new URL(location.href);
      for (const [key, value] of [['category', category], ['tag', tag], ['page', currentPage > 1 ? String(currentPage) : '']]) {
        if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
      }
      history.pushState({}, '', url);
    }
  };
  const readUrl = () => {
    const params = new URL(location.href).searchParams;
    category = params.get('category') ?? '';
    tag = params.get('tag') ?? '';
    currentPage = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);
    render();
  };
  buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.category ?? ''; tag = ''; currentPage = 1; render(true); }));
  document.getElementById('clear-tag')?.addEventListener('click', () => { tag = ''; currentPage = 1; render(true); });
  document.getElementById('reset-category')?.addEventListener('click', () => { category = ''; tag = ''; currentPage = 1; render(true); });
  for (const [id, delta] of [['page-prev', -1], ['page-next', 1]] as const) document.getElementById(id)?.addEventListener('click', () => { currentPage += delta; render(true); document.querySelector('.archive-toolbar')?.scrollIntoView({block:'start'}); });
  addEventListener('popstate', readUrl);
  readUrl();
</script>
