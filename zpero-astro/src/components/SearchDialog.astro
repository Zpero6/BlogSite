---
import type { BlogPost } from '../lib/posts';
import Icon from './Icon.astro';

interface Props { posts: BlogPost[] }
const { posts } = Astro.props;
const searchItems = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags,
  href: `/blog/${post.id}/`,
}));
---

<div id="search-overlay" class="fixed inset-0 z-[65] hidden items-start justify-center bg-[#171717]/25 px-5 pt-[112px] backdrop-blur-[4px] sm:pt-[132px]" role="presentation">
  <div class="w-full max-w-[480px] rounded-[14px] border border-zinc-200 bg-white p-5 shadow-[0_28px_70px_-24px_rgba(0,0,0,.22)]" role="dialog" aria-modal="true" aria-label="搜索文章">
    <div class="flex items-center gap-3 border-b border-[#171717]/10 pb-4 text-[#171717]/45">
      <Icon name="search" size={17} />
      <input id="search-input" type="search" placeholder="搜索文章或技术关键词..." autocomplete="off" class="min-w-0 flex-1 bg-transparent text-[13px] text-[#171717] outline-none placeholder:text-[#171717]/35" />
      <button id="search-close" aria-label="关闭搜索" class="flex h-7 w-7 items-center justify-center rounded-full transition-colors hover:bg-zinc-100"><Icon name="x" size={16} /></button>
    </div>
    <div id="search-results" class="max-h-[55vh] overflow-y-auto pt-2"></div>
  </div>
</div>

<script define:vars={{ searchItems }}>
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const openButton = document.getElementById('search-open');
  const closeButton = document.getElementById('search-close');
  let restoreFocus = null;

  const escapeHtml = (value) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);

  const render = (value = '') => {
    const query = value.trim().toLocaleLowerCase();
    const matched = searchItems.filter((item) => !query || [item.title, item.description, item.category, ...item.tags].join(' ').toLocaleLowerCase().includes(query));
    results.innerHTML = matched.length ? matched.map((item) => `
      <a href="${item.href}" class="group flex w-full items-center justify-between gap-4 rounded-lg px-3 py-3 text-left transition-colors hover:bg-zinc-100">
        <span class="min-w-0"><span class="block truncate text-[12px] font-semibold text-[#171717]/85">${escapeHtml(item.title)}</span><span class="mt-1 block text-[10px] text-[#171717]/40">文章 · ${escapeHtml(item.category)}</span></span>
        <span class="shrink-0 text-[#171717]/30 group-hover:text-[#171717]">→</span>
      </a>`).join('') : '<p class="px-3 py-7 text-center text-[12px] text-[#171717]/45">暂时没有找到相关内容。</p>';
  };

  const open = () => {
    restoreFocus = document.activeElement;
    input.value = '';
    render();
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';
    input.focus();
  };

  const close = () => {
    if (overlay.classList.contains('hidden')) return;
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
    document.body.style.overflow = '';
    restoreFocus?.focus?.();
  };

  openButton?.addEventListener('click', open);
  closeButton?.addEventListener('click', close);
  input?.addEventListener('input', (event) => render(event.target.value));
  overlay?.addEventListener('click', (event) => { if (event.target === overlay) close(); });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); open(); }
  });
</script>
