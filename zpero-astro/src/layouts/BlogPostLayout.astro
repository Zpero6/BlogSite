---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { BlogPost } from '../lib/posts';
import { getReadingMinutes } from '../lib/posts';
import { resolveCover } from '../lib/covers';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
  nextPost?: BlogPost;
}

const { post, headings, nextPost } = Astro.props;
const cover = resolveCover(post.data.cover, post.id);
const minutes = getReadingMinutes(post.body ?? '');
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${post.data.title} · Zpero`} description={post.data.description} image={cover} article>
  <main class="article-page subpage mx-auto min-h-[76vh] max-w-[1136px] pb-20 pt-[126px] sm:pt-[146px]">
    <div class="article-grid grid items-start">
      <article class="article-column mx-auto w-full min-w-0 lg:mx-0">
        <a href="/blog/" class="article-back mb-9"><span class="article-back__icon"><Icon name="arrow" size={13} /></span>返回文章列表</a>
        <div class="article-meta mb-5 flex flex-wrap items-center gap-3 sm:gap-3.5">
          <span class="article-category">{post.data.category}</span>
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          <span>{minutes} MIN READ</span>
        </div>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-summary">{post.data.description}</p>
        <div class="article-tags mt-6 flex flex-wrap gap-2.5" aria-label="文章标签">
          {post.data.tags.map((tag) => <span class="article-tag">#{tag}</span>)}
        </div>
        <div class="article-cover mt-10 aspect-video overflow-hidden bg-zinc-100">
          <Image src={cover} alt={post.data.coverAlt ?? post.data.title} widths={[760, 960, 1200]} sizes="(max-width: 760px) 100vw, 760px" class="h-full w-full object-cover" />
        </div>

        {toc.length > 0 && (
          <details class="article-toc article-toc--mobile my-10 lg:hidden">
            <summary class="cursor-pointer text-[13px] font-semibold text-[#171717]">文章目录 <span class="ml-2 text-[11px] font-normal text-zinc-400">/ {toc.length} 个章节</span></summary>
            <nav class="mt-4" aria-label="移动端文章目录">
              {toc.map((heading) => <a href={`#${heading.slug}`} class:list={['toc-link', heading.depth === 3 && 'is-child']}>{heading.text}</a>)}
            </nav>
          </details>
        )}

        <div class="article-copy mt-12 lg:mt-14"><slot /></div>

        <div class="mt-12 border-t border-[#171717]/10 pt-6">
          <p class="text-[10px] leading-[1.8] text-[#171717]/35">文章与封面由 Git 管理，提交后自动生成静态页面。</p>
          {nextPost && (
            <a href={`/blog/${nextPost.id}/`} class="group mt-7 flex items-center justify-between gap-6 rounded-lg border border-zinc-200/70 bg-white px-5 py-4">
              <span><span class="block text-[9px] text-[#171717]/40">继续阅读 / NEXT POST</span><strong class="mt-1 block text-[12px] font-semibold text-[#171717]/80 group-hover:text-[#171717]">{nextPost.data.title}</strong></span>
              <Icon name="arrow" size={15} />
            </a>
          )}
        </div>
      </article>

      {toc.length > 0 && (
        <aside class="article-toc sticky top-[118px] hidden lg:block" aria-label="文章目录">
          <div class="mb-1.5 flex items-center gap-2.5 text-[13px] font-bold text-[#171717]"><span class="h-1.5 w-1.5 rounded-full bg-[#CBF033]"></span>目录</div>
          <p class="mb-5 text-[10px] font-semibold tracking-[.12em] text-[#171717]/32">TABLE OF CONTENTS</p>
          <nav>{toc.map((heading) => <a href={`#${heading.slug}`} data-toc={heading.slug} class:list={['toc-link', heading.depth === 3 && 'is-child']}>{heading.text}</a>)}</nav>
        </aside>
      )}
    </div>
  </main>
</BaseLayout>

<script>
  const updateToc = () => {
    const links = [...document.querySelectorAll<HTMLElement>('[data-toc]')];
    const headings = links.map((link) => document.getElementById(link.dataset.toc ?? '')).filter(Boolean) as HTMLElement[];
    if (!headings.length) return;
    let current = headings[0].id;
    for (const heading of headings) if (heading.getBoundingClientRect().top <= 170) current = heading.id;
    links.forEach((link) => link.classList.toggle('is-current', link.dataset.toc === current));
  };
  let pending = false;
  addEventListener('scroll', () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => { pending = false; updateToc(); });
  }, { passive: true });
  updateToc();
</script>
