---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { BlogPost } from '../lib/posts';
import { getReadingMinutes } from '../lib/posts';
import { resolveCover } from '../lib/covers';
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import '../styles/reading.css';
interface Props { post: BlogPost; headings: MarkdownHeading[]; nextPost?: BlogPost }
const { post, headings, nextPost } = Astro.props;
const cover = resolveCover(post.data.cover, post.id);
const normalize = (text: string) => text.replace(/\s/g, '').toLowerCase();
const toc = headings.filter((h) => h.depth <= 4 && normalize(h.text) !== normalize(post.data.title));
const minDepth = toc.length ? Math.min(...toc.map((h) => h.depth)) : 1;
const minutes = getReadingMinutes(post.body ?? '');
const chars = (post.body ?? '').replace(/!\[[^\]]*\]\([^)]*\)/g, '').replace(/\s/g, '').length;
const date = (value: Date) => value.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---
<BaseLayout title={`${post.data.title} · Zpero`} description={post.data.description} image={cover} article>
  <div class="reading-progress" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
  <main class="reading-shell">
    <aside class="reading-sidebar" aria-label="文章目录">
      {toc.length > 0 && <nav class="reading-toc"><h2>本文目录</h2><div class="reading-toc__scroll" data-reading-toc-scroll>{toc.map((h) => <a href={`#${h.slug}`} data-reading-toc={h.slug} style={`--toc-depth:${Math.min(2, h.depth - minDepth)}`}>{h.text}</a>)}</div></nav>}
    </aside>
    <article class="reading-article">
      <header class="reading-heading">
        <a class="reading-back" href="/blog/">← 返回文章</a>
        <div class="reading-meta"><time datetime={post.data.pubDate.toISOString()}>{date(post.data.pubDate)}</time><span aria-hidden="true">·</span><span>约 {chars.toLocaleString('zh-CN')} 字符</span><span aria-hidden="true">·</span><span>{minutes} 分钟阅读</span>{post.data.updatedDate && <span>更新于 <time datetime={post.data.updatedDate.toISOString()}>{date(post.data.updatedDate)}</time></span>}</div>
        <h1 id="reading-title">{post.data.title}</h1>
        <p class="reading-description">{post.data.description}</p>
        <div class="reading-tags" aria-label="文章主题">{post.data.tags.map((tag) => <a href={`/blog/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
      </header>
      <div class="reading-cover"><Image src={cover} alt={post.data.coverAlt ?? post.data.title} widths={[760, 1000, 1400]} sizes="(max-width: 767px) 100vw, 820px" loading="eager" /></div>
      <div class="markdown-prose" id="reading-content"><slot /></div>
      {nextPost && nextPost.id !== post.id && <section class="reading-related" aria-labelledby="related-heading"><h2 id="related-heading">继续阅读</h2><PostCard post={nextPost} preview /></section>}
    </article>
    <div class="reading-balance" aria-hidden="true"></div>
  </main>
  {toc.length > 0 && <><button class="reading-toc-toggle" id="reading-toc-open" type="button" aria-haspopup="dialog" aria-controls="reading-toc-dialog" aria-expanded="false">☰ 目录</button><dialog class="reading-toc-dialog" id="reading-toc-dialog" aria-labelledby="reading-toc-title"><div class="reading-dialog-heading"><h2 id="reading-toc-title">本文目录</h2><button type="button" data-reading-close aria-label="关闭目录">×</button></div><nav class="reading-toc__scroll" data-reading-toc-scroll>{toc.map((h) => <a href={`#${h.slug}`} data-reading-toc={h.slug} style={`--toc-depth:${Math.min(2, h.depth - minDepth)}`}>{h.text}</a>)}</nav></dialog></>}
  <button type="button" class="reading-top" id="reading-top" aria-label="返回顶部" hidden><svg viewBox="0 0 48 48" aria-hidden="true"><circle class="reading-top__track" cx="24" cy="24" r="21" /><circle class="reading-top__progress" cx="24" cy="24" r="21" /></svg><span aria-hidden="true">↑</span></button>
  <dialog id="reading-lightbox" class="reading-lightbox" aria-label="图片预览"><div class="reading-lightbox__actions"><button type="button" id="reading-zoom" aria-pressed="false">放大原图</button><button type="button" data-reading-close aria-label="关闭图片预览">×</button></div><figure><img id="reading-lightbox-image" alt="" /><figcaption id="reading-lightbox-caption"></figcaption></figure></dialog>
  <p class="sr-only" role="status" aria-live="polite" id="reading-status"></p>
  <script>import '../scripts/reading';</script>
</BaseLayout>

